# ============================================================
# .gitignore — Caro Game (C#/.NET WinForms)
# ============================================================

# ---- Operating systems ----
.DS_Store
Thumbs.db
Desktop.ini

# ---- Editors and IDEs ----
.idea/
.vscode/
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.code-workspace

# ---- .NET / C# build output ----
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
[Ll]og/
[Ll]ogs/
TestResults/
BenchmarkDotNet.Artifacts/
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json

# ---- Artifacts (build/publish/installer output) ----
artifacts/

# ---- Logs and temporary files ----
*.log
*.tmp
*.temp
*.bak
*.orig
*.swp
*~
~$*

# ---- Secrets and local configuration ----
.env
.env.*
!.env.example
*.key
*.pem
secrets.*
appsettings.Development.json
appsettings.Local.json
appsettings.*.local.json
!appsettings.Development.json.example

# ---- Python (temporary scripts) ----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Compiled binaries (standalone) ----
*.exe
*.dll
*.pdb
*.ilk
*.idb

# ---- Generic ----
.cache/
tmp/
temp/
